{
  "schemaVersion": 1,
  "id": "git",
  "name": "Git 仓库",
  "description": "对本地 Git 仓库执行 status/diff/log/commit 等操作，读写均走官方 mcp-server-git。",
  "icon": "📂",
  "category": "dev",
  "tags": ["git", "版本控制"],
  "homepage": "https://github.com/modelcontextprotocol/servers/tree/main/src/git",
  "server": {
    "transport": "stdio",
    "command": "uvx",
    "args": ["mcp-server-git", "--repository", "${REPO_PATH}"]
  },
  "inputs": [
    { "key": "REPO_PATH", "title": "仓库路径", "required": false, "default": "." }
  ]
}
