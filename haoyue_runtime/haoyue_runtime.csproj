<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Haoyue.Runtime</RootNamespace>
    <IsAotCompatible>true</IsAotCompatible>
    <InvariantGlobalization>true</InvariantGlobalization>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="haoyue_tests" />
    <InternalsVisibleTo Include="haoyue_model_opt" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CliWrap" />
    <PackageReference Include="Cronos" />
    <PackageReference Include="DiffPlex" />
    <PackageReference Include="LLamaSharp" />
    <!-- 本地推理原生后端二选一：默认 CPU；NVIDIA 机器用 -p:LlamaBackend=Cuda12 构建（ProviderConfig.GpuLayers>0 时权重卸载到显存）。 -->
    <PackageReference Include="LLamaSharp.Backend.Cpu" Condition="'$(LlamaBackend)' != 'Cuda12'" />
    <PackageReference Include="LLamaSharp.Backend.Cuda12" Condition="'$(LlamaBackend)' == 'Cuda12'" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.Extensions.FileSystemGlobbing" />
    <PackageReference Include="Microsoft.Extensions.Http" />
    <PackageReference Include="Microsoft.Extensions.Logging" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" />
    <PackageReference Include="Microsoft.Data.Sqlite" />
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" />
    <PackageReference Include="Polly" />
    <PackageReference Include="YamlDotNet" />
  </ItemGroup>

</Project>
