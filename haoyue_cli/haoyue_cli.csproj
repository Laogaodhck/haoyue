<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Haoyue.Cli</RootNamespace>
    <AssemblyName>haoyue</AssemblyName>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Markdig" />
    <PackageReference Include="Spectre.Console" />
    <PackageReference Include="System.CommandLine" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\haoyue_runtime\haoyue_runtime.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="haoyue_cli_tests" />
  </ItemGroup>

  <ItemGroup>
    <None Include="prompts\**\*" CopyToOutputDirectory="PreserveNewest" />
    <!-- doc_toolkit（doc_render 工具的 Python 实现）：随 CLI 输出目录分发，
         运行时经 ResolveToolkitPath 的「可执行文件相对目录」命中。 -->
    <None Include="..\doc_toolkit\**\*.py" Link="doc_toolkit\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <!-- 连接器目录（S5）：连接器包清单 + schema + 内置本地 MCP 服务器，随 CLI 分发，
         运行时经 ConnectorCatalog.ResolveRoot 的「可执行文件相对目录」命中。
         servers/tests 是开发期 pytest 套件，不进分发产物。 -->
    <None Include="..\connectors\**\*" Exclude="..\connectors\servers\tests\**\*" Link="connectors\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
