[
  {
    "id": "browser",
    "manifest": {
      "schemaVersion": 1,
      "id": "browser",
      "name": "浏览器控制",
      "description": "驱动 Playwright 浏览器：打开网页、点击填表、截图与抓取，适合需要登录态或 JS 渲染的页面。",
      "icon": "\uD83C\uDF10",
      "category": "web",
      "tags": [
        "浏览器",
        "网页",
        "自动化"
      ],
      "homepage": "https://github.com/microsoft/playwright-mcp",
      "server": {
        "transport": "stdio",
        "command": "npx",
        "args": [
          "-y",
          "@playwright/mcp@latest"
        ],
        "env": {
          "PLAYWRIGHT_HEADLESS": "${HEADLESS}"
        }
      },
      "inputs": [
        {
          "key": "HEADLESS",
          "title": "是否无头模式（true/false）",
          "required": false,
          "default": "false"
        }
      ],
      "trustReadOnly": false,
      "mutatingTools": [
        "browser_click",
        "browser_type",
        "browser_navigate",
        "browser_fill_form",
        "browser_press_key"
      ]
    }
  },
  {
    "id": "calendar",
    "manifest": {
      "schemaVersion": 1,
      "id": "calendar",
      "name": "日历（ICS）",
      "description": "读取 iCalendar 订阅链接或 .ics 文件，列出日程事件，支持订阅节假日/排班/会议室日历。",
      "icon": "\uD83D\uDCC5",
      "category": "productivity",
      "tags": [
        "日历",
        "ICS",
        "日程"
      ],
      "offline": true,
      "server": {
        "transport": "stdio",
        "command": "python",
        "args": [
          "${LOCAL_SERVER}"
        ]
      },
      "inputs": [
        {
          "key": "LOCAL_SERVER",
          "title": "内置服务器路径（自动填充，无需修改）",
          "required": false
        }
      ],
      "readOnlyTools": [
        "clipboard_get",
        "ics_events",
        "rss_read",
        "http_request",
        "email_list",
        "notify_send"
      ]
    }
  },
  {
    "id": "clipboard",
    "manifest": {
      "schemaVersion": 1,
      "id": "clipboard",
      "name": "剪贴板",
      "description": "读写系统剪贴板文本，让代理能与桌面应用交换内容（复制结果、取选中文本）。",
      "icon": "\uD83D\uDCCB",
      "category": "system",
      "tags": [
        "剪贴板",
        "桌面"
      ],
      "offline": true,
      "server": {
        "transport": "stdio",
        "command": "python",
        "args": [
          "${LOCAL_SERVER}"
        ]
      },
      "inputs": [
        {
          "key": "LOCAL_SERVER",
          "title": "内置服务器路径（自动填充，无需修改）",
          "required": false
        }
      ],
      "mutatingTools": [
        "clipboard_set"
      ],
      "readOnlyTools": [
        "clipboard_get",
        "ics_events",
        "rss_read",
        "http_request",
        "email_list",
        "notify_send"
      ]
    }
  },
  {
    "id": "email",
    "manifest": {
      "schemaVersion": 1,
      "id": "email",
      "name": "邮箱（IMAP/SMTP）",
      "description": "收件箱浏览与邮件发送，基于 haoyue 内置本地服务器（纯标准库），支持任意提供 IMAP/SMTP 的邮箱。",
      "icon": "\uD83D\uDCE7",
      "category": "communication",
      "tags": [
        "邮件",
        "IMAP",
        "SMTP"
      ],
      "offline": true,
      "server": {
        "transport": "stdio",
        "command": "python",
        "args": [
          "${LOCAL_SERVER}"
        ],
        "env": {
          "IMAP_HOST": "${IMAP_HOST}",
          "IMAP_PORT": "${IMAP_PORT}",
          "IMAP_USER": "${IMAP_USER}",
          "IMAP_PASSWORD": "${IMAP_PASSWORD}",
          "SMTP_HOST": "${SMTP_HOST}",
          "SMTP_PORT": "${SMTP_PORT}",
          "SMTP_USER": "${SMTP_USER}",
          "SMTP_PASSWORD": "${SMTP_PASSWORD}"
        }
      },
      "inputs": [
        {
          "key": "LOCAL_SERVER",
          "title": "内置服务器路径（自动填充，无需修改）",
          "required": false
        },
        {
          "key": "IMAP_HOST",
          "title": "IMAP 服务器地址（如 imap.qq.com）",
          "required": true
        },
        {
          "key": "IMAP_PORT",
          "title": "IMAP 端口",
          "required": false,
          "default": "993"
        },
        {
          "key": "IMAP_USER",
          "title": "邮箱账号",
          "required": true
        },
        {
          "key": "IMAP_PASSWORD",
          "title": "授权码/密码",
          "description": "多数服务商使用专用授权码而非登录密码。",
          "required": true,
          "secret": true
        },
        {
          "key": "SMTP_HOST",
          "title": "SMTP 服务器地址（如 smtp.qq.com）",
          "required": true
        },
        {
          "key": "SMTP_PORT",
          "title": "SMTP 端口",
          "required": false,
          "default": "587"
        },
        {
          "key": "SMTP_USER",
          "title": "SMTP 账号（通常与邮箱相同）",
          "required": false
        },
        {
          "key": "SMTP_PASSWORD",
          "title": "SMTP 授权码/密码",
          "required": false,
          "secret": true
        }
      ],
      "mutatingTools": [
        "email_send",
        "clipboard_set"
      ],
      "readOnlyTools": [
        "email_list",
        "clipboard_get",
        "ics_events",
        "rss_read",
        "http_request",
        "notify_send"
      ]
    }
  },
  {
    "id": "git",
    "manifest": {
      "schemaVersion": 1,
      "id": "git",
      "name": "Git 仓库",
      "description": "对本地 Git 仓库执行 status/diff/log/commit 等操作，读写均走官方 mcp-server-git。",
      "icon": "\uD83D\uDCC2",
      "category": "dev",
      "tags": [
        "git",
        "版本控制"
      ],
      "homepage": "https://github.com/modelcontextprotocol/servers/tree/main/src/git",
      "server": {
        "transport": "stdio",
        "command": "uvx",
        "args": [
          "mcp-server-git",
          "--repository",
          "${REPO_PATH}"
        ]
      },
      "inputs": [
        {
          "key": "REPO_PATH",
          "title": "仓库路径",
          "required": false,
          "default": "."
        }
      ]
    }
  },
  {
    "id": "github",
    "manifest": {
      "schemaVersion": 1,
      "id": "github",
      "name": "GitHub",
      "description": "管理 GitHub 仓库、Issue、Pull Request 与文件，需要个人访问令牌（repo 权限按需缩小）。",
      "icon": "\uD83D\uDC19",
      "category": "dev",
      "tags": [
        "github",
        "代码协作"
      ],
      "homepage": "https://github.com/modelcontextprotocol/servers/tree/main/src/github",
      "server": {
        "transport": "stdio",
        "command": "npx",
        "args": [
          "-y",
          "@modelcontextprotocol/server-github"
        ],
        "env": {
          "GITHUB_PERSONAL_ACCESS_TOKEN": "${GITHUB_TOKEN}"
        }
      },
      "inputs": [
        {
          "key": "GITHUB_TOKEN",
          "title": "GitHub 个人访问令牌",
          "description": "在 GitHub → Settings → Developer settings → Personal access tokens 生成；建议只勾选所需仓库权限。",
          "required": true,
          "secret": true
        }
      ],
      "mutatingTools": [
        "create_issue",
        "create_pull_request",
        "merge_pull_request",
        "create_branch",
        "push_files",
        "create_or_update_file",
        "delete_file",
        "fork_repository",
        "add_issue_comment"
      ]
    }
  },
  {
    "id": "http-api",
    "manifest": {
      "schemaVersion": 1,
      "id": "http-api",
      "name": "HTTP API 通用器",
      "description": "向任意 HTTP API 发起 GET/POST/PUT/DELETE 请求并解析 JSON 响应，是接入内部系统与开放 API 的万能后门。",
      "icon": "\uD83D\uDD0C",
      "category": "data",
      "tags": [
        "HTTP",
        "API",
        "REST"
      ],
      "offline": true,
      "server": {
        "transport": "stdio",
        "command": "python",
        "args": [
          "${LOCAL_SERVER}"
        ]
      },
      "inputs": [
        {
          "key": "LOCAL_SERVER",
          "title": "内置服务器路径（自动填充，无需修改）",
          "required": false
        }
      ],
      "readOnlyTools": [
        "clipboard_get",
        "ics_events",
        "rss_read",
        "http_request",
        "email_list",
        "notify_send"
      ]
    }
  },
  {
    "id": "notify",
    "manifest": {
      "schemaVersion": 1,
      "id": "notify",
      "name": "系统通知",
      "description": "发送 Windows/macOS/Linux 桌面通知，适合长任务完成提醒、审批提醒等场景。",
      "icon": "\uD83D\uDD14",
      "category": "system",
      "tags": [
        "通知",
        "提醒"
      ],
      "offline": true,
      "server": {
        "transport": "stdio",
        "command": "python",
        "args": [
          "${LOCAL_SERVER}"
        ]
      },
      "inputs": [
        {
          "key": "LOCAL_SERVER",
          "title": "内置服务器路径（自动填充，无需修改）",
          "required": false
        }
      ],
      "readOnlyTools": [
        "clipboard_get",
        "ics_events",
        "rss_read",
        "http_request",
        "email_list",
        "notify_send"
      ]
    }
  },
  {
    "id": "notion",
    "manifest": {
      "schemaVersion": 1,
      "id": "notion",
      "name": "Notion",
      "description": "读写 Notion 页面与数据库（官方 Notion MCP 服务器），需要集成令牌并先在页面连接授权。",
      "icon": "\uD83D\uDCD2",
      "category": "productivity",
      "tags": [
        "notion",
        "知识库",
        "文档"
      ],
      "homepage": "https://github.com/makenotion/notion-mcp-server",
      "server": {
        "transport": "stdio",
        "command": "npx",
        "args": [
          "-y",
          "@notionhq/notion-mcp-server"
        ],
        "env": {
          "OPENAPI_MCP_HEADERS": "{\"Authorization\": \"Bearer ${NOTION_TOKEN}\", \"Notion-Version\": \"2022-06-28\"}"
        }
      },
      "inputs": [
        {
          "key": "NOTION_TOKEN",
          "title": "Notion 集成令牌",
          "description": "在 notion.so/my-integrations 创建 internal integration，并为目标页面授予访问权限。",
          "required": true,
          "secret": true
        }
      ]
    }
  },
  {
    "id": "rss",
    "manifest": {
      "schemaVersion": 1,
      "id": "rss",
      "name": "RSS 订阅",
      "description": "读取 RSS 2.0 / Atom 源的最新条目，用于信息流追踪、竞品监控与内容聚合。",
      "icon": "\uD83D\uDCF0",
      "category": "productivity",
      "tags": [
        "RSS",
        "资讯",
        "订阅"
      ],
      "offline": true,
      "server": {
        "transport": "stdio",
        "command": "python",
        "args": [
          "${LOCAL_SERVER}"
        ]
      },
      "inputs": [
        {
          "key": "LOCAL_SERVER",
          "title": "内置服务器路径（自动填充，无需修改）",
          "required": false
        }
      ],
      "readOnlyTools": [
        "clipboard_get",
        "ics_events",
        "rss_read",
        "http_request",
        "email_list",
        "notify_send"
      ]
    }
  },
  {
    "id": "sqlite",
    "manifest": {
      "schemaVersion": 1,
      "id": "sqlite",
      "name": "SQLite 数据库",
      "description": "对指定 SQLite 数据库执行查询与模式浏览（官方 mcp-server-sqlite），适合本地数据分析。",
      "icon": "\uD83D\uDDC4️",
      "category": "data",
      "tags": [
        "sqlite",
        "数据库",
        "分析"
      ],
      "homepage": "https://github.com/modelcontextprotocol/servers/tree/main/src/sqlite",
      "server": {
        "transport": "stdio",
        "command": "uvx",
        "args": [
          "mcp-server-sqlite",
          "--db-path",
          "${DB_PATH}"
        ]
      },
      "inputs": [
        {
          "key": "DB_PATH",
          "title": "数据库文件路径",
          "required": true
        }
      ]
    }
  }
]
