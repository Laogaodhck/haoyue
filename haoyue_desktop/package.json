{
  "name": "haoyue-desktop",
  "version": "1.3.32",
  "private": true,
  "description": "Haoyue（浩玥）desktop client",
  "main": "./out/main/index.js",
  "type": "module",
  "scripts": {
    "postinstall": "node node_modules/electron/install.js",
    "dev": "electron-vite dev",
    "preview": "electron-vite preview",
    "sync:contract": "node scripts/generate-contract.mjs",
    "typecheck": "vue-tsc --noEmit -p tsconfig.web.json && tsc --noEmit -p tsconfig.node.json",
    "lint": "eslint .",
    "format": "prettier --write \"src/**/*.{ts,vue}\"",
    "format:check": "prettier --check \"src/**/*.{ts,vue}\"",
    "guard:components": "node scripts/check-line-budget.mjs",
    "test": "vitest run",
    "build": "pnpm typecheck && electron-vite build",
    "package": "pnpm build && electron-builder --dir",
    "dist": "pnpm build && electron-builder"
  },
  "author": {
    "name": "Haoyue",
    "email": "xiaomai@hoilai.com"
  },
  "homepage": "https://github.com/Laogaodhck/haoyue",
  "dependencies": {
    "@electron-toolkit/utils": "^4.0.0",
    "@lucide/vue": "^1.27.0",
    "highlight.js": "^11.11.1",
    "katex": "^0.18.10",
    "markdown-it": "^14.3.3",
    "mermaid": "^11.17.2",
    "vue": "^3.5.42"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@swc/core": "^1.15.47",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^26.1.2",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/test-utils": "^2.5.1",
    "electron": "^45.2.1",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.12.0",
    "globals": "^16.5.0",
    "jsdom": "^30.1.3",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^7.3.6",
    "vitest": "^4.1.10",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.3.8"
  },
  "build": {
    "appId": "com.hoilai.haoyue",
    "productName": "Haoyue",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "resources/**/*",
      "package.json"
    ],
    "win": {
      "icon": "resources/favicon.ico",
      "target": "nsis",
      "extraResources": [
        {
          "from": "runtime/win-x64",
          "to": "runtime",
          "filter": [
            "**/*"
          ]
        }
      ]
    },
    "linux": {
      "icon": "resources/logo.png",
      "target": [
        "dir"
      ],
      "maintainer": "Haoyue <support@haoyue.local>",
      "category": "Development",
      "extraResources": [
        {
          "from": "runtime/linux-x64",
          "to": "runtime",
          "filter": [
            "**/*"
          ]
        }
      ]
    }
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@swc/core",
      "electron",
      "esbuild"
    ],
    "overrides": {
      "nanoid": ">=3.3.18",
      "undici": ">=8.12.2",
      "dompurify": ">=3.4.17",
      "source-map-js": ">=1.2.2",
      "mermaid>katex": ">=0.18.2"
    }
  },
  "packageManager": "pnpm@10.33.2"
}