<?xml version="1.0" encoding="utf-8" ?>
<!--
  测试金字塔覆盖率门槛（见 haoyue_doc/adr/ 与 haoyue_doc/测试金字塔与覆盖率门槛-2026-10-07.md）。
  用法：dotnet test haoyue_tests 收集覆盖率时用 settings 参数指向本文件。
  阈值策略（2026-10-15 实测基线：行 73.1%、分支 56.9%）：
  - 核心业务逻辑 haoyue_runtime 行覆盖率 ≥70%，随测试补全逐步上调至 85%；
  - 分支覆盖率 ≥55%（分支需要更多测试才能爬升，门槛跟随基线渐进上调）。
-->
<RunSettings>
  <DataCollectionRunSettings>
    <DataCollectors>
      <DataCollector friendlyName="XPlat Code Coverage">
        <Configuration>
          <Format>cobertura</Format>
          <Exclude>[haoyue_cli]*,[haoyue_webserver]*,[*test*]*</Exclude>
          <Include>[haoyue_runtime*]*</Include>
          <Threshold>70</Threshold>
          <ThresholdType>line</ThresholdType>
          <ThresholdStat>total</ThresholdStat>
          <Threshold>55</Threshold>
          <ThresholdType>branch</ThresholdType>
          <ThresholdStat>total</ThresholdStat>
        </Configuration>
      </DataCollector>
    </DataCollectors>
  </DataCollectionRunSettings>
</RunSettings>
