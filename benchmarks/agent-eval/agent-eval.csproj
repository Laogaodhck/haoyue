<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Haoyue.Benchmarks.AgentEval</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- 评测可执行工程，不是测试工程：在 Haoyue.slnx 里参与 solution 级 build 编译校验，
         但 dotnet test 遍历解决方案时必须跳过它（无测试适配器）。 -->
    <IsTestProject>false</IsTestProject>
  </PropertyGroup>

  <!-- 与 haoyue_runtime 保持一致的原生后端（评测本地模型时需要）。 -->
  <ItemGroup>
    <PackageReference Include="LLamaSharp.Backend.Cpu" Condition="'$(LlamaBackend)' != 'Cuda12'" />
    <PackageReference Include="LLamaSharp.Backend.Cuda12" Condition="'$(LlamaBackend)' == 'Cuda12'" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\haoyue_runtime\haoyue_runtime.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- 评测走真实 runtime 链路，工具描述与 doc_render 依赖必须就位：
         prompts 来自 CLI（FilePromptProvider 的 AppDir 根），doc_toolkit 供
         DocRenderTool 的「可执行文件相对目录」探测命中。 -->
    <None Include="..\..\haoyue_cli\prompts\**\*" Link="prompts\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\doc_toolkit\**\*.py" Link="doc_toolkit\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
