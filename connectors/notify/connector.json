{
  "schemaVersion": 1,
  "id": "notify",
  "name": "系统通知",
  "description": "发送 Windows/macOS/Linux 桌面通知，适合长任务完成提醒、审批提醒等场景。",
  "icon": "🔔",
  "category": "system",
  "tags": ["通知", "提醒"],
  "offline": true,
  "server": {
    "transport": "stdio",
    "command": "python",
    "args": ["${LOCAL_SERVER}"]
  },
  "inputs": [
    { "key": "LOCAL_SERVER", "title": "内置服务器路径（自动填充，无需修改）", "required": false }
  ],
  "readOnlyTools": ["clipboard_get", "ics_events", "rss_read", "http_request", "email_list", "notify_send"]
}
